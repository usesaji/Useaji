# Copy to .env.local. Nothing here is required: the console talks to the Railway API by default.

# `mock` answers every call from the in-browser mock in src/mocks instead (demo login
# admin@usesaji.com / Password1) — for demos without an admin account.
# NEXT_PUBLIC_API_SOURCE=mock

# The backend (Swagger: https://saji-backend-production-0025.up.railway.app/docs), with its /v1 prefix.
# The browser calls /api/v1 and /api/health on this app, which forward here (next.config.ts).
API_PROXY_TARGET=https://saji-backend-production-0025.up.railway.app/v1
# A local backend instead:
# API_PROXY_TARGET=http://localhost:4000/v1
