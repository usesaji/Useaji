# Copy to .env.local. Nothing here is required to run the app: every value has a working default.
# On Vercel, set only what you want to override.

# Where data comes from (src/lib/api/source.ts). The Railway API by default. `mock` answers every
# call from the in-browser mock in src/mocks instead (offline demos: demo@usesaji.com / Password1).
# NEXT_PUBLIC_API_SOURCE=mock

# Backend API (Swagger: https://saji-backend-production-0025.up.railway.app/docs). The browser calls
# this app's /api/v1 proxy (next.config.ts), which forwards here. Defaults to the Railway API.
API_PROXY_TARGET=https://saji-backend-production-0025.up.railway.app/v1
# A local backend instead:
# API_PROXY_TARGET=http://localhost:4000/v1
# Or force direct calls (the API must allow this origin in CORS):
# NEXT_PUBLIC_API_URL=https://saji-backend-production-0025.up.railway.app/v1

# Wallets follow the API: real ones (Freighter / xBull / Albedo / LOBSTR through Stellar Wallets Kit,
# Testnet) when live, a simulated one (500 test USDC) with the mock. Override with live|mock.
# NEXT_PUBLIC_WALLET_SOURCE=live

# Google sign-in: the public OAuth client id. Never put the client secret here. Its "Authorized
# JavaScript origins" (Google Cloud console) must list every origin the app runs on, e.g.
# http://localhost:3000 and https://app.usesaji.com — otherwise Google answers origin_mismatch.
# Without it, "Continue with Google" is hidden (live) or signs into the mock's demo Google account.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# WalletConnect (Reown) project for phone wallets (LOBSTR, Freighter mobile). Public; its domain
# allowlist protects it. Without it, phone wallets are left out of the wallet kit.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Canonical URLs (optional) — src/lib/site.ts.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_LANDING_URL=http://localhost:3002
